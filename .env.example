# Razorpay — required for /checkout to take a payment.
#
# Get these from the Razorpay dashboard: Settings -> API Keys -> Generate Test Key.
# Test keys start with rzp_test_. Copy this file to .env.local (which is
# gitignored) and fill both values in, then restart the dev server — Next only
# reads env files at startup.
#
# RAZORPAY_KEY_ID is public (the browser needs it to open the payment modal).
# RAZORPAY_KEY_SECRET must never reach the browser: it signs the order and
# verifies the payment signature, and it is only ever read in the route
# handlers under app/api/razorpay/. Do not prefix either with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
